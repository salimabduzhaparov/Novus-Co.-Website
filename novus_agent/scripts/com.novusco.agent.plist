<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job (macOS): daily `novus daily` at 08:00.
     1. Edit the two REPLACE_ME paths below.
     2. cp scripts/com.novusco.agent.plist ~/Library/LaunchAgents/
     3. launchctl load ~/Library/LaunchAgents/com.novusco.agent.plist
     Unload with: launchctl unload ~/Library/LaunchAgents/com.novusco.agent.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.novusco.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_ME/.venv/bin/novus</string>
    <string>daily</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_ME</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>REPLACE_ME/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>REPLACE_ME/logs/launchd.log</string>
</dict>
</plist>
